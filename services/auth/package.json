{
  "name": "@equhub/auth-service",
  "version": "1.0.0",
  "description": "EQUHUB Authentication Service - JWT, OAuth, 2FA",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
